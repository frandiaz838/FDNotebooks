# Supabase (Settings -> API en tu proyecto de supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Login del panel admin (un solo usuario)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión del admin (string aleatorio largo)
AUTH_SECRET=

# WhatsApp que recibe las consultas, con codigo de pais, sin '+' ni espacios (ej. 5493543697964)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publica del sitio en produccion (ej. https://fd-notebooks.vercel.app)
# se completa recien en la fase de deploy; en local no hace falta.
NEXT_PUBLIC_SITE_URL=
